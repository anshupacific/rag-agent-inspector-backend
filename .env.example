# Copy to .env for local runs. On App Service, set these as app settings instead.
PROJECT_ENDPOINT=https://xxxx.ai.azure.com/api/projects/proj-default
AGENT_NAME=agent-v2-for-rag
AGENT_VERSION=3

# Comma-separated list of sites allowed to call this API from a browser.
ALLOWED_ORIGINS=http://localhost:5173

# Spend protection: per visitor (by IP) and for the whole API.
RATE_LIMIT_PER_MINUTE=10
DAILY_REQUEST_LIMIT=300
MAX_QUESTION_CHARS=500

# Per-answer evaluation with Foundry's built-in evaluators.
# The judge model is a chat deployment in the same Foundry project.
EVAL_MODEL_DEPLOYMENT=gpt-5.4-mini
EVALUATORS=groundedness,relevance,task_adherence
EVAL_TIMEOUT_SECONDS=180
# Optional: reuse one evaluation definition across restarts (the app logs the ID it creates).
EVAL_ID=

# Name shown on the site when the guardrail blocks a question. The guardrail itself
# is created in Foundry and assigned to the agent there.
GUARDRAIL_NAME=rag-guardrail
